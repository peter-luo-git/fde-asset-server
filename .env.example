# 资产服务（本地进程形态）
FDE_ASSET_DATABASE_URL=sqlite+aiosqlite:///~/.fde/data/asset.db
FDE_ASSET_DATA_DIR=~/.fde/data/assets
FDE_ASSET_REPO_DIR=~/.fde/repos
FDE_ASSET_WORK_DIR=~/.fde/work
# fde-server（成员关系查询）
FDE_SERVER_INTERNAL_URL=http://127.0.0.1:8000
# Casdoor（v0.1 本地可留空，留空时按开发身份放行并打印警告）
FDE_CASDOOR_URL=
FDE_ASSET_OIDC_CLIENT_ID=
FDE_ASSET_OIDC_CLIENT_SECRET=
# 索引轮询间隔（秒）
FDE_ASSET_INDEX_POLL_SECONDS=30
